{
  "name": "Dusty Chaos Apocalypse",
  "type": "dark",
  "colors": {
    "editor.background": "#140005",
    "editor.foreground": "#ff4444",
    "activityBar.background": "#3a000d",
    "activityBar.foreground": "#ff0055",
    "sideBar.background": "#1f0007",
    "sideBar.foreground": "#ffaaaa",
    "statusBar.background": "#ff0033",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#280009",
    "titleBar.activeForeground": "#ff5555",
    "editorLineNumber.foreground": "#aa2244",
    "editorLineNumber.activeForeground": "#ffff00",
    "editorCursor.foreground": "#00ffff",
    "terminal.background": "#140005",
    "terminal.foreground": "#ff0055"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": { "foreground": "#883344", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type"],
      "settings": { "foreground": "#ff0055", "fontStyle": "bold" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#ffaa00" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#00ffff" }
    },
    {
      "scope": ["variable"],
      "settings": { "foreground": "#ffff55" }
    }
  ]
}
